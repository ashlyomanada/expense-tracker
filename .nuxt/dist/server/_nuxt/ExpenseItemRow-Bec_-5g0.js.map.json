{"file":"ExpenseItemRow-Bec_-5g0.js","mappings":";;;;;;AAaO,SAAS,oBACd,aACA,WACA,SACc;AACd,MAAI,CAAC,UAAU,OAAQ,QAAO,CAAA;AAE9B,QAAM,gBAAgB,WAAW,WAAW;AAC5C,QAAM,IAAI,UAAU;AACpB,QAAM,eAAe,KAAK,MAAM,gBAAgB,CAAC;AACjD,QAAM,oBAAoB,gBAAgB,eAAe;AAIzD,QAAM,uBAAuB,WAAW,UAAU,SAAS,OAAO,IAC9D,UACA,UAAU,CAAC;AAEf,SAAO,UAAU,IAAI,CAAC,WAAW;AAC/B,UAAM,cAAc,WAAW;AAC/B,UAAM,WAAW,gBAAgB,cAAc,oBAAoB;AACnE,WAAO;AAAA,MACL;AAAA,MACA,aAAa,aAAa,QAAQ;AAAA,IAAA;AAAA,EAEtC,CAAC;AACH;;;;;;;;;;;;;AClCA,UAAM,QAAQ;AAYA,aAAA;AAEd,UAAM,SAAS,SAAS,MAAM;AAC5B,aAAO,oBAAoB,MAAM,WAAW,MAAM,mBAAmB,MAAM,OAAO;AAAA,IACpF,CAAC;AAED,UAAM,kBAAkB,CAAC,WAAkC;AACzD,YAAM,QAAQ,OAAO,MAAM,KAAK,CAAC,MAAM,EAAE,WAAW,MAAM;AAC1D,aAAO,QAAQ,MAAM,cAAc;AAAA,IACrC;;;mBAqBOA,eAAAC,WAAA,EAAA,OAAM,cAAA,GAAa,MAAA,CAAA,iMAKbC,eAAA,QAAA,kBAAkB,MAAM,QAAUA,eAAA,QAAA,QAAQ,MAAM;UAG3C,QAAA,kBAAkB,SAAM,KAAQ,QAAA,YAAS,GAAA;AAC/C,cAAA,8EAAAA,eAAAC,MAAA,WAAA,EAAY,QAAA,YAAY,0BAAkB,QAAQ,QAAA,QAAQ,CAAA,CAAA,iBAAA;AAAA;;;;AAM7CC,oBAAA,QAAA,UAAV,WAAM;AAIL,cAAA,gCAAAC,eAAA,CAAA,QAAA,kBAAkB,SAAS,OAAO,EAAE;;UAMzC,MAAM,QAAA,kBAAkB,SAAS,OAAO,EAAE,IAAA,sCAAA;AAAA,UAC3C,OAAM;AAAA,QAAA;AAEC,cAAA,SAAAH,eAAA,OAAO,YAAY,CAAA,SAAA;YAEpB,QAAA,kBAAkB,SAAS,OAAO,EAAE,KAAK,gBAAgB,OAAO,EAAE,MAAA,MAAA;AAGrE,gBAAA,8FAAAA,eAAAC,MAAA,WAAA,EAAY,gBAAgB,OAAO,EAAE,GAAI,QAAA,QAAQ,CAAA,CAAA,SAAA;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;ACnE9D,UAAM,QAAQ;AAUd,UAAM,OAAO;AAIb,UAAM,YAAY,SAAS,MAAM;AAC/B,YAAM,MAAM,OAAO,MAAM,KAAK,QAAQ,KAAK;AAC3C,YAAM,QAAQ,OAAO,MAAM,KAAK,UAAU,KAAK;AAC/C,aAAO,KAAK,MAAM,MAAM,QAAQ,GAAG,IAAI;AAAA,IACzC,CAAC;;;;;;AAIM,YAAA,OAAAH,eAAAC,WAAA,EAAA,OAAM,gHAA4G,MAAA,CAAA,CAAA,2DAAA;;QAKtG,YAAA,QAAA,KAAK;AAAA,QAAL,uBAAA,CAAA,WAAA,QAAA,KAAK,OAAI;AAAA,QAClB,aAAY;AAAA,QACZ,MAAK;AAAA,QACL,MAAK;AAAA,QACL,UAAA;AAAA,MAAA;;;QAMS,YAAA,QAAA,KAAK;AAAA,QAAL,uBAAA,CAAA,WAAA,QAAA,KAAK,cAAW;AAAA,QACxB,SAAS,QAAA;AAAA,QACV,oBAAiB;AAAA,QACjB,mBAAgB;AAAA,QAChB,aAAY;AAAA,QACZ,MAAK;AAAA,MAAA;;UAKD,QAAA,WAAS;;UACf,MAAK;AAAA,UACL,OAAM;AAAA,UACN,SAAQ;AAAA,UACR,MAAK;AAAA,UACL,MAAK;AAAA,UACL,OAAM;AAAA,UACL,qBAAO,KAAI,QAAA;AAAA,QAAA;;;;;;QASM,YAAA,QAAA,KAAK;AAAA,QAAL,uBAAA,CAAA,WAAA,QAAA,KAAK,WAAQ;AAAA,wBAA7B,EAAA,QAAA,KAAA;AAAA,QACA,MAAK;AAAA,QACL,KAAI;AAAA,QACJ,MAAK;AAAA,QACL,MAAK;AAAA,MAAA;;;QAOW,YAAA,QAAA,KAAK;AAAA,QAAL,uBAAA,CAAA,WAAA,QAAA,KAAK,aAAU;AAAA,wBAA/B,EAAA,QAAA,KAAA;AAAA,QACA,MAAK;AAAA,QACL,KAAI;AAAA,QACJ,MAAK;AAAA,QACL,MAAK;AAAA,QACL,aAAY;AAAA,MAAA;gNAOTE,MAAA,WAAA,EAAYA,MAAA,SAAA,GAAW,QAAA,QAAQ,CAAA,CAAA,uFAAA;;QAQnC,SAAS,QAAA;AAAA,QACF,uBAAqB,QAAA,KAAK;AAAA,QAAL,8BAAA,CAAA,WAAA,QAAA,KAAK,sBAAmB;AAAA,QACpD,cAAYA,MAAA,SAAA;AAAA,QACZ,YAAU,QAAA;AAAA,QACV,UAAU,QAAA;AAAA,MAAA;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_unref","_ssrRenderList","_ssrRenderClass"],"sources":["../../../../utils/split.ts","../../../../components/MemberChips.vue","../../../../components/ExpenseItemRow.vue"],"sourcesContent":["import { toCentavos, fromCentavos } from './money'\n\nexport interface SplitShare {\n  userId: string\n  shareAmount: number\n}\n\n/**\n * Splits an amount equally among selected members.\n * Leftover centavos go to the payer (if payer is among the split members),\n * or to the first member in the list.\n * Sum of shares is guaranteed to exactly equal totalAmount.\n */\nexport function calculateEqualSplit(\n  totalAmount: number | string,\n  memberIds: string[],\n  payerId?: string\n): SplitShare[] {\n  if (!memberIds.length) return []\n\n  const totalCentavos = toCentavos(totalAmount)\n  const n = memberIds.length\n  const baseCentavos = Math.floor(totalCentavos / n)\n  const remainderCentavos = totalCentavos - baseCentavos * n\n\n  // Leftover centavos go to the payer if they are in the split;\n  // otherwise to the first member in the split list\n  const remainderRecipientId = payerId && memberIds.includes(payerId)\n    ? payerId\n    : memberIds[0]\n\n  return memberIds.map((userId) => {\n    const isRecipient = userId === remainderRecipientId\n    const centavos = baseCentavos + (isRecipient ? remainderCentavos : 0)\n    return {\n      userId,\n      shareAmount: fromCentavos(centavos),\n    }\n  })\n}\n\n/**\n * Validates that an array of shares exactly sums to the total amount.\n */\nexport function validateSplitSum(\n  totalAmount: number | string,\n  shares: { shareAmount: number | string }[]\n): boolean {\n  const totalCentavos = toCentavos(totalAmount)\n  const sharesCentavos = shares.reduce((acc, s) => acc + toCentavos(s.shareAmount), 0)\n  return totalCentavos === sharesCentavos\n}\n\n","<script setup lang=\"ts\">\nimport type { HouseholdMember } from '~/composables/useHousehold'\nimport { calculateEqualSplit } from '~/utils/split'\nimport { formatMoney } from '~/utils/money'\n\nconst props = defineProps<{\n  members: HouseholdMember[]\n  selectedMemberIds: string[]\n  itemTotal: number\n  payerId?: string\n  currency?: string\n}>()\n\nconst emit = defineEmits<{\n  (e: 'update:selectedMemberIds', ids: string[]): void\n}>()\n\nconst toast = useToast()\n\nconst shares = computed(() => {\n  return calculateEqualSplit(props.itemTotal, props.selectedMemberIds, props.payerId)\n})\n\nconst getShareForUser = (userId: string): number | null => {\n  const share = shares.value.find((s) => s.userId === userId)\n  return share ? share.shareAmount : null\n}\n\nconst toggleMember = (userId: string) => {\n  const isSelected = props.selectedMemberIds.includes(userId)\n  if (isSelected) {\n    if (props.selectedMemberIds.length <= 1) {\n      toast.add({\n        title: 'Selection required',\n        description: 'At least one member must share this item.',\n        color: 'amber',\n      })\n      return\n    }\n    emit('update:selectedMemberIds', props.selectedMemberIds.filter((id) => id !== userId))\n  } else {\n    emit('update:selectedMemberIds', [...props.selectedMemberIds, userId])\n  }\n}\n</script>\n\n<template>\n  <div class=\"space-y-1.5\">\n    <div class=\"flex items-center justify-between\">\n      <span class=\"text-xs font-medium text-gray-500 dark:text-gray-400\">\n        Split with:\n        <span class=\"text-gray-900 dark:text-gray-200 font-semibold\">\n          {{ selectedMemberIds.length }} of {{ members.length }} members\n        </span>\n      </span>\n      <span v-if=\"selectedMemberIds.length > 0 && itemTotal > 0\" class=\"text-xs text-primary-600 dark:text-primary-400 font-medium\">\n        ~{{ formatMoney(itemTotal / selectedMemberIds.length, currency) }}/person\n      </span>\n    </div>\n\n    <div class=\"flex flex-wrap gap-1.5\">\n      <button\n        v-for=\"member in members\"\n        :key=\"member.id\"\n        type=\"button\"\n        class=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium border transition-all cursor-pointer\"\n        :class=\"selectedMemberIds.includes(member.id)\n          ? 'bg-primary-50 dark:bg-primary-950 text-primary-700 dark:text-primary-300 border-primary-300 dark:border-primary-700 shadow-sm'\n          : 'bg-gray-50 dark:bg-gray-800 text-gray-400 dark:text-gray-500 border-gray-200 dark:border-gray-700 hover:border-gray-300 opacity-60'\"\n        @click=\"toggleMember(member.id)\"\n      >\n        <UIcon\n          :name=\"selectedMemberIds.includes(member.id) ? 'i-heroicons-check-circle-20-solid' : 'i-heroicons-plus-circle'\"\n          class=\"w-3.5 h-3.5\"\n        />\n        <span>{{ member.display_name }}</span>\n        <span\n          v-if=\"selectedMemberIds.includes(member.id) && getShareForUser(member.id) !== null\"\n          class=\"font-mono text-[10px] bg-primary-100 dark:bg-primary-900 px-1 py-0.2 rounded\"\n        >\n          {{ formatMoney(getShareForUser(member.id)!, currency) }}\n        </span>\n      </button>\n    </div>\n  </div>\n</template>\n","<script setup lang=\"ts\">\nimport type { HouseholdMember, HouseholdCategory } from '~/composables/useHousehold'\nimport { formatMoney } from '~/utils/money'\n\nexport interface EditableItem {\n  id?: string\n  name: string\n  quantity: number\n  unit_price: number\n  category_id?: string\n  selected_member_ids: string[]\n}\n\nconst props = defineProps<{\n  item: EditableItem\n  index: number\n  members: HouseholdMember[]\n  categories: HouseholdCategory[]\n  payerId: string\n  currency?: string\n  canRemove: boolean\n}>()\n\nconst emit = defineEmits<{\n  (e: 'remove'): void\n}>()\n\nconst lineTotal = computed(() => {\n  const qty = Number(props.item.quantity) || 1\n  const price = Number(props.item.unit_price) || 0\n  return Math.round(qty * price * 100) / 100\n})\n</script>\n\n<template>\n  <div class=\"p-3.5 bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 space-y-3 shadow-xs\">\n    <!-- Top row: Item name, Category, and Remove -->\n    <div class=\"flex items-start gap-2\">\n      <div class=\"flex-1\">\n        <UInput\n          v-model=\"item.name\"\n          placeholder=\"Item name (e.g. Eggs, Laundry Soap)\"\n          size=\"sm\"\n          icon=\"i-heroicons-tag\"\n          required\n        />\n      </div>\n\n      <div class=\"w-36\">\n        <USelect\n          v-model=\"item.category_id\"\n          :options=\"categories\"\n          option-attribute=\"name\"\n          value-attribute=\"id\"\n          placeholder=\"Category\"\n          size=\"sm\"\n        />\n      </div>\n\n      <UButton\n        v-if=\"canRemove\"\n        type=\"button\"\n        color=\"red\"\n        variant=\"ghost\"\n        icon=\"i-heroicons-trash\"\n        size=\"xs\"\n        class=\"mt-0.5\"\n        @click=\"emit('remove')\"\n      />\n    </div>\n\n    <!-- Middle row: Quantity, Unit Price, and Line Total -->\n    <div class=\"grid grid-cols-12 gap-2 items-center\">\n      <div class=\"col-span-3\">\n        <div class=\"text-[11px] text-gray-500 mb-0.5\">Qty</div>\n        <UInput\n          v-model.number=\"item.quantity\"\n          type=\"number\"\n          min=\"1\"\n          step=\"1\"\n          size=\"sm\"\n        />\n      </div>\n\n      <div class=\"col-span-5\">\n        <div class=\"text-[11px] text-gray-500 mb-0.5\">Unit Price</div>\n        <UInput\n          v-model.number=\"item.unit_price\"\n          type=\"number\"\n          min=\"0\"\n          step=\"0.01\"\n          size=\"sm\"\n          placeholder=\"0.00\"\n        />\n      </div>\n\n      <div class=\"col-span-4 text-right\">\n        <div class=\"text-[11px] text-gray-500 mb-0.5\">Line Total</div>\n        <div class=\"font-mono font-semibold text-sm text-gray-900 dark:text-white\">\n          {{ formatMoney(lineTotal, currency) }}\n        </div>\n      </div>\n    </div>\n\n    <!-- Bottom: Member split chips -->\n    <div class=\"pt-2 border-t border-gray-100 dark:border-gray-800/60\">\n      <MemberChips\n        :members=\"members\"\n        v-model:selected-member-ids=\"item.selected_member_ids\"\n        :item-total=\"lineTotal\"\n        :payer-id=\"payerId\"\n        :currency=\"currency\"\n      />\n    </div>\n  </div>\n</template>\n"],"version":3}